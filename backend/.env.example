# CyberEye SIEM Backend Environment Configuration Example
# Copy this file to .env and fill in real values before running the backend.

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ES_LOGS_INDEX=siem-logs
ES_ALERTS_INDEX=siem-alerts

# --- Server ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10

# --- Detection rule engine ---
RULE_ENGINE_CRON=*/30 * * * * *

# ---------- AI Investigation ----------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# --- AbuseIPDB (Phase 4: source IP enrichment) ---
# API required here
ABUSEIPDB_API_KEY=API required here

# --- Slack (Phase 4: critical alert notifications) ---
# API required here
SLACK_WEBHOOK_URL=API required here

# Public base URL used to build the "view alert" deep-link in Slack messages
DASHBOARD_BASE_URL=http://localhost:5173

# --- Authentication & RBAC (Phase 7C) ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
ES_USERS_INDEX=siem-users

# Initial Administrator Provisioning (required on initial setup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_me
