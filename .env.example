# CyberEye SIEM - Root Environment Configuration Example
# Copy this file to .env before deploying on a LAN.
# Replace 'localhost' with your CyberEye Host machine's LAN IP address (e.g. 192.168.1.50)

# The IP address of the machine hosting CyberEye.
CYBEREYE_HOST_IP=localhost

# Allowed CORS origin for the frontend (needed for API & WebSockets to work across LAN)
FRONTEND_ORIGIN=http://${CYBEREYE_HOST_IP}:5173

# Base URL used to construct incident deep-links in Slack alerts
DASHBOARD_BASE_URL=http://${CYBEREYE_HOST_IP}:5173
